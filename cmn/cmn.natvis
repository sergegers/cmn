<?xml version="1.0" encoding="utf-8"?> 
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">

    <Type Name="cmn::basic_fixed_string&lt;*,*,*&gt;">
        <DisplayString>{{ {m_data._Elems,na} }}</DisplayString>
        <Expand>
            <Item Name="[data]">m_data._Elems,na</Item>            
            <Item Name="[size]">$T2</Item>            
        </Expand>
    </Type>
    
    <Type Name="cmn::enum_::basic_qualified_name&lt;*,*&gt;">
        <DisplayString>{{ {m_name,na} }}</DisplayString>
        <Expand>
            <Item Name="[name]">m_name,na</Item>
            <Item Name="[namespace]">m_ns,na</Item>
            <Item Name="[enum name]">m_enum_name,na</Item>
        </Expand>    
    </Type>
    
    <Type Name="cmn::enum_::basic_qualified_member_name&lt;*,*&gt;">
        <DisplayString>{{ {m_name,na} }}</DisplayString>
        <Expand>
            <Item Name="[name]">m_name,na</Item>
            <Item Name="[namespace]">m_ns,na</Item>
            <Item Name="[enum name]">m_enum_name,na</Item>
            <Item Name="[enum member name]">m_enum_member_name,na</Item>
        </Expand>
    </Type>
    
<!--    <Type Name="cmn::emum_::record_info&lt;*&gt;">
        <DisplayString>enum_value,en</DisplayString>
        <Expand>
            <Item Name="[value]">enum_value,en</Item>
            <Item Name="[name]">m_name</Item>
            <Item Name="[wide_name]">m_wname</Item>
        </Expand>
    </Type> -->
    
    <Type Name="cmn::io::strong_typedef_formatter&lt;*,*&gt;">     
        <Intrinsic Name="radix" Expression="(cmn::io::radix_fmt_t)(m_fmt_options &amp; cmn::io::radix_fmt_t::mask)"/>
        <Intrinsic Name="base" Expression="(cmn::io::base_fmt_t)(m_fmt_options &amp; cmn::io::base_fmt_t::mask)"/>
        <Intrinsic Name="lang" Expression="(cmn::io::lang_fmt_t)(m_fmt_options &amp; cmn::io::lang_fmt_t::mask)"/>
        <Intrinsic Name="width" Expression="(cmn::io::width_fmt_t)(m_fmt_options &amp; cmn::io::width_fmt_t::mask)"/>
        <Intrinsic Name="case_" Expression="(cmn::io::case_fmt_t)(m_fmt_options &amp; cmn::io::case_fmt_t::mask)"/>
        <Intrinsic Name="sign" Expression="(cmn::io::case_fmt_t)(m_fmt_options &amp; cmn::io::sign_fmt_t::mask)"/>
        <Expand>
            <Item Name="[format options]">m_fmt_options,b</Item>
            <Item Name="[radix]">radix()</Item>
            <Item Name="[base]">base()</Item>
            <Item Name="[language]">lang()</Item>
            <Item Name="[width]">width()</Item>
            <Item Name="[sign]">sign()</Item>
        </Expand>
    </Type>
    
</AutoVisualizer>